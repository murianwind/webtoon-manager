# ── 경로 ──────────────────────────────────────────────────────
# 아래 세 값은 전부 컨테이너 내부 경로다. 실제 호스트 위치는 docker-compose.yml의
# volumes에서 매핑한다 — 이 파일에서 바꿀 필요 없이, docker-compose 배포 시
# WEBTOON_DOWNLOAD_HOST_PATH / APP_DATA_HOST_PATH / COOKIE_DIR_HOST_PATH만 지정하면 됨.
DOWNLOAD_ROOT=/data/Webtoon_Download
DATABASE_PATH=/data/webtoons.db

# 성인 인증 쿠키 파일 경로. Playwright storage_state 형식(JSON)으로 export한 것.
# {"cookies": [{"name": "NID_AUT", "domain": ".naver.com", "value": "..."}, ...]} 형식.
# /data 밑이 아니라 별도 경로(/cookies)에 마운트한다 — /data와 겹치면 도커가 컨테이너를
# 준비할 때 그 자리를 미리 만들면서, APP_DATA_HOST_PATH 쪽 호스트 폴더에 빈 폴더가
# 계속 생기는 부작용이 있다.
COOKIE_FILE_PATH=/cookies/chokobo_murian.json

# ── 다운로드 동작 튜닝 (선택, 기본값으로 충분하면 안 넣어도 됨) ──────────
FOLDER_ZERO_FILL=4
IMAGE_ZERO_FILL=4
MAX_CONCURRENT_DOWNLOADS=10
ARTIST_SCAN_CONCURRENCY=5
DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=10

# 다운로드 잡 1회 실행당 작품 하나가 새로 받을 회차 수 상한. 0 이하면 무제한.
# 오래 밀린 작품이 한 번에 몰려서 네이버에 부담 주는 걸 막는다.
MAX_NEW_EPISODES_PER_TITLE=10
# 위 상한에 걸렸을 때, 다음 배치를 이어받기 전 쉬는 시간(분).
BATCH_REST_MINUTES=5.0

# ── 디스코드 / 작가·태그 자동추가 / 실행 스케줄 ───────────────────
# 전부 여기서 관리하지 않는다 — 앱 실행 후 웹페이지에서 직접 설정한다.
# (디스코드: 설정 탭, 암호화되어 DB에 저장됨 / 작가·태그: 작가·태그 관리 탭 /
#  스케줄: 설정 탭 실행 스케줄)
