# ── 다운로드 경로 ─────────────────────────────────────────────
# 웹툰 이미지가 저장될 최상위 폴더 (컨테이너 내부 경로, 실제 위치는 docker-compose 볼륨으로 매핑)
DOWNLOAD_ROOT=/data/Webtoon_Download

# SQLite DB 파일 경로 (컨테이너 내부, 영속 볼륨에 매핑)
DATABASE_PATH=/data/webtoons.db

# ── 성인 인증 쿠키 ────────────────────────────────────────────
# Playwright storage_state 형식(JSON)으로 export한 브라우저 쿠키 파일 경로.
# {"cookies": [{"name": "NID_AUT", "domain": ".naver.com", "value": "..."}, ...]} 형식이면 됨.
# 컨테이너 내부 경로 기준이며, docker-compose에서 실제 파일을 볼륨으로 마운트해야 함.
COOKIE_FILE_PATH=/data/cookies/chokobo_murian.json

# ── 다운로드 동작 튜닝 (선택, 기본값으로 충분하면 안 넣어도 됨) ──────────
# 다운로드 잡 1회 실행당 작품 하나가 새로 받을 회차 수 상한. 0 이하면 무제한.
# 오래 밀린 작품이 한 번에 몰려서 네이버에 부담 주는 걸 막는다.
MAX_NEW_EPISODES_PER_TITLE=10
# 위 상한에 걸렸을 때, 다음 배치를 이어받기 전 쉬는 시간(분).
BATCH_REST_MINUTES=5.0

# 디스코드 설정(웹훅 URL / 봇 토큰 / 알림 채널 ID)은 여기서 관리하지 않는다.
# 앱 실행 후 웹페이지의 설정 탭에서 입력한다 — DB에 암호화되어 저장되고,
# 암호화 키는 DATABASE_PATH와 같은 폴더에 자동 생성된다 (별도 설정 불필요).

# ── 태그(큐레이션) 자동추가 ───────────────────────────────────
# comic.naver.com CUSTOM_TAG 큐레이션 id, 콤마로 구분
WEBTOON_TAG_IDS=134,133

# ── 다운로드 동작 설정 ────────────────────────────────────────
FOLDER_ZERO_FILL=4
IMAGE_ZERO_FILL=4
MAX_CONCURRENT_DOWNLOADS=10
DELAY_SECONDS=1
REQUEST_TIMEOUT_SECONDS=10

# ── 스케줄 주기 (분) ──────────────────────────────────────────
SCAN_INTERVAL_MINUTES=360
DOWNLOAD_INTERVAL_MINUTES=60
COMMANDS_ONLY_INTERVAL_MINUTES=5

# ── 웹서버 ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
